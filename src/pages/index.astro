---
import BaseLayout from "../layouts/BaseLayout.astro";
import BeatmapDashboard from "../components/BeatmapDashboard.vue";
import {
    DEFAULT_TIER,
    FILE_LOOKUPS,
    assertManifest,
    dataUrl,
} from "../domain/manifest";

// load data manifest
import manifest from "../manifest.json";
const files = assertManifest(manifest);

// core data preloaded
const preloads = [
    files.tiers[DEFAULT_TIER].core,
    ...FILE_LOOKUPS.map((k) => files.lookups[k].core),
].map(dataUrl);
---

<BaseLayout title="Home" description="The main page of the app.">
    <link rel="preconnect" href="https://assets.ppy.sh" />
    <!-- download before Vue island runs -->
    {
        preloads.map((href) => (
            <link
                rel="preload"
                as="fetch"
                href={href}
                crossorigin="anonymous"
            />
        ))
    }
    <h1>Astro</h1>
    <BeatmapDashboard client:only="vue" files={files} />
</BaseLayout>
