---
import BaseHead from "./BaseHead.astro";
import Navbar from "./Navbar.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
        <BaseHead title={title} description={description} />
        <slot name="head" />
  </head>
  <body>
        <Navbar />
        <main>
            <!-- SLOT FOR CONTENT -->
        <slot />
    </main>
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }
  nav,
  main {
    max-width: var(--max);
    margin: 0 auto;
    padding: 1rem;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--fg);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--accent);
  }
  nav a[aria-current="page"] {
    font-weight: 600;
    border-bottom: 2px solid var(--accent);
  }
  .brand {
    font-weight: 700;
  }
</style>

<!-- GLOBAL STYLES FOR CHILDREN -->
<style is:global>
  :root {
    --bg: #fff;
    --fg: #1a1a1a;
    --accent: #2563eb;
    --border: #e5e5e5;
    --max: 42rem;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111;
      --fg: #eee;
      --accent: #60a5fa;
      --border: #2a2a2a;
    }
  }
  *,
  ::before,
  ::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font:
      1rem/1.6 system-ui,
      sans-serif;
  }
  a {
    color: var(--accent);
  }
</style>